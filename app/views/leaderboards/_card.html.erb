<% percentage_of = local_assigns[:percentage_of].to_i %>
<% subtitle_for = local_assigns[:subtitle_for] %>
<% visible_entries, hidden_entries = entries.first(5), entries.drop(5) %>
<% card_classes = "rounded-xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-5 shadow-md transition-transform duration-200 dark:border-gray-800 dark:from-gray-900 dark:to-gray-950" %>
<% card_classes += " hover:scale-[1.02]" if hidden_entries.any? %>
<div data-controller="modal" class="<%= card_classes %>">
  <% if hidden_entries.any? %>
    <button type="button" data-action="modal#open" class="mb-4 flex w-full cursor-pointer items-center gap-2 text-left text-xl transition hover:text-emerald-700 dark:hover:text-emerald-400">
      <span><%= emoji %></span><%= title %>
    </button>
  <% else %>
    <h2 class="mb-4 flex items-center gap-2 text-xl"><span><%= emoji %></span><%= title %></h2>
  <% end %>

  <% if entries.empty? %>
    <p class="text-sm text-gray-500 dark:text-gray-400">Nothing recorded yet.</p>
  <% else %>
    <ol class="space-y-1">
      <% visible_entries.each do |entry| %>
        <%= render "entry", entry: entry, percentage_of: percentage_of, subtitle_for: subtitle_for %>
      <% end %>
    </ol>

    <% if hidden_entries.any? %>
      <dialog data-modal-target="dialog" data-action="click->modal#closeOnBackdrop"
              class="m-auto w-full max-w-sm rounded-xl border border-gray-200 bg-white p-5 text-gray-900 shadow-xl backdrop:bg-black/50 dark:border-gray-800 dark:bg-gray-900 dark:text-gray-100">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="flex items-center gap-2 text-xl"><span><%= emoji %></span><%= title %></h2>
          <button type="button" data-action="modal#close" aria-label="Close"
                  class="rounded-md px-2 py-1 text-lg text-gray-400 hover:bg-gray-100 hover:text-gray-600 dark:hover:bg-gray-800 dark:hover:text-gray-300">✕</button>
        </div>
        <ol class="space-y-1">
          <% entries.each do |entry| %>
            <%= render "entry", entry: entry, percentage_of: percentage_of, subtitle_for: subtitle_for %>
          <% end %>
        </ol>
      </dialog>
    <% end %>
  <% end %>
</div>
