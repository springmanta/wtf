<% percentage_of = local_assigns[:percentage_of].to_i %>
<% subtitle_for = local_assigns[:subtitle_for] %>
<% visible_entries, hidden_entries = entries.first(5), entries.drop(5) %>
<div class="rounded-xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-5 shadow-md dark:border-gray-800 dark:from-gray-900 dark:to-gray-950">
  <h2 class="mb-4 flex items-center gap-2 text-xl"><span><%= emoji %></span><%= title %></h2>

  <% if entries.empty? %>
    <p class="text-sm text-gray-500 dark:text-gray-400">Nothing recorded yet.</p>
  <% else %>
    <ol class="space-y-1">
      <% visible_entries.each do |entry| %>
        <%= render "entry", entry: entry, percentage_of: percentage_of, subtitle_for: subtitle_for %>
      <% end %>
    </ol>

    <% if hidden_entries.any? %>
      <details class="group mt-1">
        <summary class="flex cursor-pointer list-none items-center justify-center gap-1 rounded-lg px-2 py-2 text-xs font-medium text-emerald-700 transition hover:bg-gray-100 [&::-webkit-details-marker]:hidden dark:text-emerald-400 dark:hover:bg-gray-800">
          <span class="group-open:hidden">Show <%= hidden_entries.size %> more</span>
          <span class="hidden group-open:inline">Show less</span>
          <span class="inline-block transition-transform duration-200 group-open:rotate-180">▾</span>
        </summary>
        <ol class="mt-1 space-y-1">
          <% hidden_entries.each do |entry| %>
            <%= render "entry", entry: entry, percentage_of: percentage_of, subtitle_for: subtitle_for %>
          <% end %>
        </ol>
      </details>
    <% end %>
  <% end %>
</div>
