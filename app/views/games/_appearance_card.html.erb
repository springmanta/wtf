<%
  player = f.object.player
  zone = { "team_one" => "teamOne", "team_two" => "teamTwo" }.fetch(f.object.team, "bench")
  zone_bg = {
    "bench" => "bg-white/95 dark:bg-gray-800/95",
    "teamOne" => "bg-emerald-100 dark:bg-emerald-600",
    "teamTwo" => "bg-sky-100 dark:bg-sky-600"
  }.fetch(zone)
%>
<div class="flex w-20 shrink-0 touch-none select-none flex-col items-center gap-1 rounded-lg <%= zone_bg %> px-2 py-2 text-center shadow cursor-grab active:cursor-grabbing"
     draggable="false"
     tabindex="0"
     data-roster-target="card"
     data-zone="<%= zone %>"
     data-skills="<%= player.skills.values.to_json %>"
     data-action="pointerdown->roster#startDrag keydown.enter->roster#cycleOnKey keydown.space->roster#cycleOnKey">
  <%= f.hidden_field :player_id %>
  <%= f.hidden_field :team, data: { role: "team-field" } %>

  <div class="h-8 w-8 overflow-hidden rounded-full bg-emerald-600 dark:bg-emerald-500">
    <% if player.photo.attached? %>
      <%= image_tag player.photo.variant(resize_to_fill: [64, 64]), class: "h-full w-full object-cover", alt: player.name %>
    <% else %>
      <div class="flex h-full w-full items-center justify-center text-xs font-bold text-white"><%= player.initials %></div>
    <% end %>
  </div>
  <div class="w-full truncate text-xs font-medium text-gray-800 dark:text-gray-100"><%= player.name %></div>

  <div class="flex items-center gap-0.5 text-xs" data-role="stat-stepper" <%= "hidden" if zone == "bench" %> title="Goals">
    <span class="text-[10px]">⚽</span>
    <button type="button" class="flex h-5 w-5 items-center justify-center rounded bg-gray-100 font-bold text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" data-stat="goals" data-action="click->roster#decrementStat">−</button>
    <span class="w-3 tabular-nums" data-role="goals-display"><%= f.object.goals.to_i %></span>
    <button type="button" class="flex h-5 w-5 items-center justify-center rounded bg-gray-100 font-bold text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" data-stat="goals" data-action="click->roster#incrementStat">+</button>
    <%= f.hidden_field :goals, data: { role: "goals-field" } %>
  </div>

  <div class="flex items-center gap-0.5 text-xs" data-role="stat-stepper" <%= "hidden" if zone == "bench" %> title="Assists">
    <span class="text-[10px]">🅰️</span>
    <button type="button" class="flex h-5 w-5 items-center justify-center rounded bg-gray-100 font-bold text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" data-stat="assists" data-action="click->roster#decrementStat">−</button>
    <span class="w-3 tabular-nums" data-role="assists-display"><%= f.object.assists.to_i %></span>
    <button type="button" class="flex h-5 w-5 items-center justify-center rounded bg-gray-100 font-bold text-gray-600 hover:bg-gray-200 dark:bg-gray-700 dark:text-gray-200 dark:hover:bg-gray-600" data-stat="assists" data-action="click->roster#incrementStat">+</button>
    <%= f.hidden_field :assists, data: { role: "assists-field" } %>
  </div>
</div>
