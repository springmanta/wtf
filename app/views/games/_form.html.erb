<%= form_with model: game, class: "space-y-8" do |form| %>
  <% if game.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
      <h2 class="font-semibold"><%= pluralize(game.errors.count, "error") %> prevented this game from saving:</h2>
      <ul class="mt-2 list-disc pl-5">
        <% game.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :played_on, "Date", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= form.date_field :played_on, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
    </div>
    <div>
      <%= form.label :location, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= form.text_field :location, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 p-4 dark:border-gray-800">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :team_one_name, "Team A name", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= form.text_field :team_one_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
        <%= form.label :team_one_score, "Team A score", class: "mt-3 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= form.number_field :team_one_score, min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
      </div>
      <div>
        <%= form.label :team_two_name, "Team B name", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= form.text_field :team_two_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
        <%= form.label :team_two_score, "Team B score", class: "mt-3 block text-sm font-medium text-gray-700 dark:text-gray-300" %>
        <%= form.number_field :team_two_score, min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
      </div>
    </div>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_area :notes, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
  </div>

  <div>
    <h2 class="mb-2 text-lg font-semibold">Who played?</h2>
    <% if game.appearances.empty? %>
      <p class="text-sm text-gray-500 dark:text-gray-400">
        No players yet — <%= link_to "add some players", new_player_path %> first.
      </p>
    <% else %>
      <%
        bench_appearances = game.appearances.select { |a| a.team.blank? }
        team_one_appearances = game.appearances.select { |a| a.team == "team_one" }
        team_two_appearances = game.appearances.select { |a| a.team == "team_two" }
      %>
      <p class="mb-3 text-xs text-gray-500 dark:text-gray-400">Drag a player onto a half of the pitch (or tap a player to cycle bench → <%= game.team_one_name.presence || "Team A" %> → <%= game.team_two_name.presence || "Team B" %>).</p>
      <div data-controller="roster" class="space-y-3">
        <div>
          <h3 class="mb-2 text-sm font-semibold text-gray-600 dark:text-gray-300">Bench</h3>
          <div data-roster-target="benchZone" class="flex min-h-24 flex-wrap justify-center gap-3 rounded-lg border-2 border-dashed border-gray-300 p-3 dark:border-gray-700">
            <%= form.fields_for :appearances, bench_appearances do |appearance_form| %>
              <%= render "appearance_card", f: appearance_form %>
            <% end %>
          </div>
        </div>

        <div class="relative mx-auto max-w-md overflow-hidden rounded-2xl border-4 border-white shadow-inner dark:border-gray-800">
          <div class="relative flex flex-col bg-emerald-600 p-4 dark:bg-emerald-800" style="min-height: 260px;">
            <div class="relative z-10 mb-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wide text-white/90">
              <span><%= game.team_one_name.presence || "Team A" %></span>
              <span><span data-roster-target="teamOneCount">0</span>/5</span>
            </div>
            <div class="pointer-events-none absolute left-1/2 top-0 h-8 w-28 -translate-x-1/2 border-2 border-t-0 border-white/30"></div>
            <div data-roster-target="teamOneZone" class="relative z-20 flex flex-1 flex-col justify-center gap-3">
              <div data-roster-target="teamOneTopRow" class="flex flex-wrap justify-center gap-3"></div>
              <div data-roster-target="teamOneBottomRow" class="flex flex-wrap justify-center gap-3">
                <%= form.fields_for :appearances, team_one_appearances do |appearance_form| %>
                  <%= render "appearance_card", f: appearance_form %>
                <% end %>
              </div>
            </div>
          </div>

          <div class="relative z-10 h-1 bg-white/70 dark:bg-gray-900">
            <div class="pointer-events-none absolute left-1/2 top-1/2 h-16 w-16 -translate-x-1/2 -translate-y-1/2 rounded-full border-2 border-white/40"></div>
          </div>

          <div class="relative flex flex-col bg-emerald-700 p-4 dark:bg-emerald-900" style="min-height: 260px;">
            <div data-roster-target="teamTwoZone" class="relative z-20 flex flex-1 flex-col justify-center gap-3">
              <div data-roster-target="teamTwoTopRow" class="flex flex-wrap justify-center gap-3"></div>
              <div data-roster-target="teamTwoBottomRow" class="flex flex-wrap justify-center gap-3">
                <%= form.fields_for :appearances, team_two_appearances do |appearance_form| %>
                  <%= render "appearance_card", f: appearance_form %>
                <% end %>
              </div>
            </div>
            <div class="pointer-events-none absolute bottom-0 left-1/2 h-8 w-28 -translate-x-1/2 border-2 border-b-0 border-white/30"></div>
            <div class="relative z-10 mt-3 flex items-center justify-between text-xs font-semibold uppercase tracking-wide text-white/90">
              <span><%= game.team_two_name.presence || "Team B" %></span>
              <span><span data-roster-target="teamTwoCount">0</span>/5</span>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "rounded-md bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800" %>
    <%= link_to "Cancel", games_path, class: "text-sm text-gray-500 hover:underline dark:text-gray-400" %>
  </div>
<% end %>
