<%= form_with model: game, class: "space-y-8" do |form| %>
  <% if game.errors.any? %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700">
      <h2 class="font-semibold"><%= pluralize(game.errors.count, "error") %> prevented this game from saving:</h2>
      <ul class="mt-2 list-disc pl-5">
        <% game.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :played_on, "Date", class: "block text-sm font-medium text-gray-700" %>
      <%= form.date_field :played_on, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>
    <div>
      <%= form.label :location, class: "block text-sm font-medium text-gray-700" %>
      <%= form.text_field :location, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 p-4">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :team_one_name, "Team A name", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :team_one_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        <%= form.label :team_one_score, "Team A score", class: "mt-3 block text-sm font-medium text-gray-700" %>
        <%= form.number_field :team_one_score, min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>
      <div>
        <%= form.label :team_two_name, "Team B name", class: "block text-sm font-medium text-gray-700" %>
        <%= form.text_field :team_two_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
        <%= form.label :team_two_score, "Team B score", class: "mt-3 block text-sm font-medium text-gray-700" %>
        <%= form.number_field :team_two_score, min: 0, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
      </div>
    </div>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-medium text-gray-700" %>
    <%= form.text_area :notes, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm" %>
  </div>

  <div>
    <h2 class="mb-2 text-lg font-semibold">Who played?</h2>
    <% if game.appearances.empty? %>
      <p class="text-sm text-gray-500">
        No players yet — <%= link_to "add some players", new_player_path %> first.
      </p>
    <% else %>
      <div class="overflow-x-auto rounded-lg border border-gray-200">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-3 py-2 text-left font-medium text-gray-500">Player</th>
              <th class="px-3 py-2 text-left font-medium text-gray-500">Team</th>
              <th class="px-3 py-2 text-left font-medium text-gray-500">Goals</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <%= form.fields_for :appearances do |appearance_form| %>
              <tr>
                <td class="px-3 py-2 align-middle">
                  <%= appearance_form.hidden_field :player_id %>
                  <%= appearance_form.object.player.name %>
                </td>
                <td class="px-3 py-2 align-middle">
                  <%= appearance_form.select :team,
                        options_for_select(
                          [
                            [ "Not playing", "" ],
                            [ game.team_one_name.presence || "Team A", "team_one" ],
                            [ game.team_two_name.presence || "Team B", "team_two" ]
                          ],
                          appearance_form.object.team
                        ),
                        {},
                        class: "block w-full rounded-md border-gray-300 shadow-sm" %>
                </td>
                <td class="px-3 py-2 align-middle">
                  <%= appearance_form.number_field :goals, min: 0, class: "block w-20 rounded-md border-gray-300 shadow-sm" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="flex items-center gap-3">
    <%= form.submit class: "rounded-md bg-emerald-700 px-4 py-2 text-sm font-semibold text-white hover:bg-emerald-800" %>
    <%= link_to "Cancel", games_path, class: "text-sm text-gray-500 hover:underline" %>
  </div>
<% end %>
