<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-md">
  <h1 class="mb-6 text-2xl font-bold">Sign in</h1>

  <%= form_with url: session_url, class: "space-y-6 rounded-xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-6 shadow-md dark:border-gray-800 dark:from-gray-900 dark:to-gray-950" do |form| %>
    <div>
      <%= form.label :email_address, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
            value: params[:email_address],
            class: "mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
            class: "mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
    </div>

    <%= form.submit "Sign in", class: "w-full rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-700 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition hover:from-emerald-700 hover:to-emerald-800 hover:shadow-lg" %>
  <% end %>
</div>
