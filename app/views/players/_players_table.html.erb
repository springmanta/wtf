<% if form %>
  <div data-bulk-select-target="actions" hidden
       class="mb-3 flex items-center gap-3 rounded-md bg-emerald-50 px-4 py-2 text-sm dark:bg-emerald-950">
    <span class="text-emerald-800 dark:text-emerald-200">
      <span data-bulk-select-target="count">0</span> selected
    </span>
    <%= form.button "Mark active", name: "active", value: "true",
          class: "rounded-md bg-emerald-700 px-3 py-1 text-xs font-semibold text-white hover:bg-emerald-800" %>
    <%= form.button "Mark inactive", name: "active", value: "false",
          class: "rounded-md bg-gray-600 px-3 py-1 text-xs font-semibold text-white hover:bg-gray-700" %>
  </div>
<% end %>

<div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-gray-200 text-sm dark:divide-gray-800">
      <thead class="bg-gray-50 dark:bg-gray-800">
        <tr>
          <% if form %>
            <th class="w-10 px-4 py-2">
              <input type="checkbox" data-bulk-select-target="selectAll" data-action="change->bulk-select#toggleAll"
                     class="h-4 w-4 rounded border-gray-300" aria-label="Select all players">
            </th>
          <% end %>
          <th class="w-10 px-4 py-2"></th>
          <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400"><%= sortable_column_link("name", "Name") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400"><%= sortable_column_link("games", "Games") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400"><%= sortable_column_link("goals", "Goals") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400"><%= sortable_column_link("assists", "Assists") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400"><%= sortable_column_link("overall", "Overall") %></th>
          <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">W-D-L</th>
          <th class="px-4 py-2 text-left font-medium text-gray-500 dark:text-gray-400">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
        <% players.each do |player| %>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
            <% if form %>
              <td class="px-4 py-2">
                <input type="checkbox" name="player_ids[]" value="<%= player.id %>"
                       data-bulk-select-target="checkbox" data-action="change->bulk-select#refresh"
                       class="h-4 w-4 rounded border-gray-300" aria-label="Select <%= player.name %>">
              </td>
            <% end %>
            <td class="px-4 py-2">
              <%= link_to player, class: "block h-8 w-8 overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800" do %>
                <% if player.photo.attached? %>
                  <%= image_tag player.photo.variant(resize_to_fill: [64, 64]), class: "h-full w-full object-cover", alt: player.name %>
                <% else %>
                  <div class="flex h-full w-full items-center justify-center text-xs font-bold text-gray-400"><%= player.initials %></div>
                <% end %>
              <% end %>
            </td>
            <td class="px-4 py-2">
              <%= link_to player.name, player, class: "font-medium text-emerald-700 hover:underline dark:text-emerald-400" %>
            </td>
            <td class="px-4 py-2 text-gray-600 dark:text-gray-300"><%= player.games_played %></td>
            <td class="px-4 py-2 text-gray-600 dark:text-gray-300"><%= player.goals_scored %></td>
            <td class="px-4 py-2 text-gray-600 dark:text-gray-300"><%= player.assists_recorded %></td>
            <td class="px-4 py-2 text-gray-600 dark:text-gray-300"><%= player.overall_rating %></td>
            <td class="px-4 py-2 whitespace-nowrap text-gray-600 dark:text-gray-300">
              <span class="text-emerald-600 dark:text-emerald-400"><%= player.wins %></span>-<span class="text-gray-500 dark:text-gray-400"><%= player.draws %></span>-<span class="text-red-500 dark:text-red-400"><%= player.losses %></span>
            </td>
            <td class="px-4 py-2">
              <% if form %>
                <button type="submit" formaction="<%= toggle_active_player_path(player, sort: @sort, direction: @direction) %>"
                        class="group inline-flex items-center gap-2">
                  <span class="relative inline-flex h-6 w-11 shrink-0 items-center rounded-full transition-colors <%= player.active? ? "bg-emerald-600" : "bg-gray-300 dark:bg-gray-600" %>">
                    <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform <%= player.active? ? "translate-x-6" : "translate-x-1" %>"></span>
                  </span>
                  <span class="text-xs font-medium text-gray-500 group-hover:text-gray-700 dark:text-gray-400 dark:group-hover:text-gray-200">
                    <%= player.active? ? "Active" : "Inactive" %>
                  </span>
                </button>
              <% else %>
                <% if player.active? %>
                  <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">Active</span>
                <% else %>
                  <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500 dark:bg-gray-800 dark:text-gray-400">Inactive</span>
                <% end %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
