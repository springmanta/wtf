<% content_for :title, "Players" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Players</h1>
  <% if authenticated? %>
    <%= link_to "New player", new_player_path, class: "rounded-md bg-emerald-700 text-white px-4 py-2 text-sm font-semibold hover:bg-emerald-800" %>
  <% end %>
</div>

<% if @players.empty? %>
  <p class="text-gray-500 dark:text-gray-400">No players yet.</p>
<% elsif authenticated? %>
  <%= form_with url: bulk_update_players_path, method: :patch, data: { controller: "bulk-select" } do |form| %>
    <%= render "players_table", players: @players, form: form %>
  <% end %>
<% else %>
  <%= render "players_table", players: @players, form: nil %>
<% end %>
