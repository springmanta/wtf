<% content_for :title, "Players" %>

<div class="mb-6 flex items-center justify-between">
  <h1 class="text-2xl font-bold">Players</h1>
  <%= link_to "New player", new_player_path, class: "rounded-md bg-emerald-700 text-white px-4 py-2 text-sm font-semibold hover:bg-emerald-800" %>
</div>

<% if @players.empty? %>
  <p class="text-gray-500">No players yet.</p>
<% else %>
  <div class="overflow-hidden rounded-lg border border-gray-200 bg-white shadow-sm">
    <table class="min-w-full divide-y divide-gray-200 text-sm">
      <thead class="bg-gray-50">
        <tr>
          <th class="px-4 py-2 text-left font-medium text-gray-500">Name</th>
          <th class="px-4 py-2 text-left font-medium text-gray-500">Games</th>
          <th class="px-4 py-2 text-left font-medium text-gray-500">Goals</th>
          <th class="px-4 py-2 text-left font-medium text-gray-500">Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% @players.each do |player| %>
          <tr class="hover:bg-gray-50">
            <td class="px-4 py-2">
              <%= link_to player.name, player, class: "font-medium text-emerald-700 hover:underline" %>
            </td>
            <td class="px-4 py-2 text-gray-600"><%= player.games_played %></td>
            <td class="px-4 py-2 text-gray-600"><%= player.goals_scored %></td>
            <td class="px-4 py-2">
              <% if player.active %>
                <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Active</span>
              <% else %>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">Inactive</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
