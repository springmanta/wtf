<%= form_with(model: player, class: "space-y-6 rounded-xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-6 shadow-md dark:border-gray-800 dark:from-gray-900 dark:to-gray-950") do |form| %>
  <% if player.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
      <h2 class="font-semibold"><%= pluralize(player.errors.count, "error") %> prevented this player from saving:</h2>
      <ul class="mt-2 list-disc pl-5">
        <% player.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :name, class: "mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.checkbox :active, class: "h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500/30 dark:border-gray-700" %>
    <%= form.label :active, "Active (shows up when recording games)", class: "text-sm text-gray-700 dark:text-gray-300" %>
  </div>

  <div class="flex items-center gap-4 pt-2">
    <%= form.submit class: "rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-700 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition hover:from-emerald-700 hover:to-emerald-800 hover:shadow-lg" %>
    <%= link_to "Cancel", players_path, class: "text-sm text-gray-500 hover:underline dark:text-gray-400" %>
  </div>
<% end %>
