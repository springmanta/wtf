<%= form_with(model: player, class: "space-y-6 rounded-xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-6 shadow-md dark:border-gray-800 dark:from-gray-900 dark:to-gray-950") do |form| %>
  <% if player.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-sm text-red-700 dark:bg-red-950 dark:text-red-300">
      <h2 class="font-semibold"><%= pluralize(player.errors.count, "error") %> prevented this player from saving:</h2>
      <ul class="mt-2 list-disc pl-5">
        <% player.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
    <%= form.text_field :name, class: "mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.checkbox :active, class: "h-4 w-4 rounded border-gray-300 text-emerald-600 focus:ring-emerald-500/30 dark:border-gray-700" %>
    <%= form.label :active, "Active (shows up when recording games)", class: "text-sm text-gray-700 dark:text-gray-300" %>
  </div>

  <div data-controller="photo-preview" class="flex items-center gap-4">
    <div class="relative h-16 w-16 shrink-0 overflow-hidden rounded-full bg-gray-100 shadow-sm dark:bg-gray-800">
      <img data-photo-preview-target="image" src="<%= player.photo_url %>" class="h-full w-full object-cover" <%= "hidden" if player.photo_url.blank? %> data-action="error->photo-preview#handleError">
      <div data-photo-preview-target="placeholder" class="flex h-full w-full items-center justify-center text-sm font-bold text-gray-400" <%= "hidden" if player.photo_url.present? %>><%= player.persisted? ? player.initials : "?" %></div>
    </div>
    <div class="flex-1">
      <%= form.label :photo_url, "Photo URL", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
      <%= form.text_field :photo_url, placeholder: "https://...",
            data: { photo_preview_target: "input", action: "input->photo-preview#update" },
            class: "mt-1.5 block w-full rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-sm shadow-sm transition focus:border-emerald-500 focus:outline-none focus:ring-2 focus:ring-emerald-500/30 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-100" %>
      <p class="mt-1 text-xs text-gray-400 dark:text-gray-500">Optional — used as their avatar on the pitch too.</p>
    </div>
  </div>

  <div class="rounded-xl border border-gray-200 bg-gradient-to-br from-gray-50 to-white p-5 shadow-sm dark:border-gray-800 dark:from-gray-950 dark:to-gray-900">
    <h2 class="mb-4 text-sm font-semibold text-gray-700 dark:text-gray-300">Skills</h2>
    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
      <% Player::SKILLS.each do |key, label| %>
        <div data-controller="slider">
          <div class="flex items-center justify-between">
            <%= form.label key, label, class: "text-sm font-medium text-gray-700 dark:text-gray-300" %>
            <span data-slider-target="output" class="text-sm font-semibold text-emerald-700 dark:text-emerald-400"><%= player.public_send(key) %></span>
          </div>
          <%= form.range_field key, in: 1..10, step: 1,
                data: { action: "input->slider#update" },
                class: "mt-1.5 w-full accent-emerald-600" %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="flex items-center gap-4 pt-2">
    <%= form.submit class: "rounded-lg bg-gradient-to-r from-emerald-600 to-emerald-700 px-5 py-2.5 text-sm font-semibold text-white shadow-md transition hover:from-emerald-700 hover:to-emerald-800 hover:shadow-lg" %>
    <%= link_to "Cancel", players_path, class: "text-sm text-gray-500 hover:underline dark:text-gray-400" %>
  </div>
<% end %>
