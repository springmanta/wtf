<% content_for :title, @player.name %>

<div class="mb-6 flex items-center justify-between">
  <%= link_to "← All players", players_path, class: "text-sm text-emerald-700 hover:underline dark:text-emerald-400" %>
  <div class="flex items-center gap-3">
    <%= link_to "Edit", edit_player_path(@player), class: "text-sm text-gray-600 hover:underline dark:text-gray-300" %>
    <%= button_to "Delete", @player, method: :delete,
          class: "border-0 bg-transparent p-0 text-sm text-red-600 hover:underline dark:text-red-400",
          form: { data: { turbo_confirm: "Delete this player?" } } %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-gradient-to-br from-white to-gray-50 p-6 shadow-md dark:border-gray-800 dark:from-gray-900 dark:to-gray-950">
  <div class="flex items-center gap-4">
    <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-gray-100 shadow-sm dark:bg-gray-800">
      <% if @player.photo.attached? %>
        <%= image_tag @player.photo.variant(resize_to_fill: [128, 128]), class: "h-full w-full object-cover", alt: @player.name %>
      <% else %>
        <div class="flex h-full w-full items-center justify-center text-lg font-bold text-gray-400"><%= @player.initials %></div>
      <% end %>
    </div>
    <div class="flex-1">
      <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold"><%= @player.name %></h1>
        <% if @player.active %>
          <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">Active</span>
        <% else %>
          <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500 dark:bg-gray-800 dark:text-gray-400">Inactive</span>
        <% end %>
      </div>
      <div class="text-sm text-gray-500 dark:text-gray-400">Overall <span class="font-semibold text-emerald-700 dark:text-emerald-400"><%= @player.overall_rating %></span>/10</div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-3 gap-4 text-center">
    <div class="rounded-md bg-gray-50 p-4 dark:bg-gray-800">
      <div class="text-2xl font-bold"><%= @player.games_played %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400">Games played</div>
    </div>
    <div class="rounded-md bg-gray-50 p-4 dark:bg-gray-800">
      <div class="text-2xl font-bold"><%= @player.goals_scored %></div>
      <div class="text-xs text-gray-500 dark:text-gray-400">Goals scored</div>
    </div>
    <div class="rounded-md bg-gray-50 p-4 dark:bg-gray-800">
      <div class="text-2xl font-bold">
        <span class="text-emerald-600 dark:text-emerald-400"><%= @player.wins %></span><span class="text-gray-300 dark:text-gray-600">-</span><span class="text-gray-500 dark:text-gray-400"><%= @player.draws %></span><span class="text-gray-300 dark:text-gray-600">-</span><span class="text-red-500 dark:text-red-400"><%= @player.losses %></span>
      </div>
      <div class="text-xs text-gray-500 dark:text-gray-400">W-D-L</div>
    </div>
  </div>

  <h2 class="mt-8 mb-3 font-semibold text-gray-700 dark:text-gray-200">Skills</h2>
  <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
    <%= render "radar_chart", player: @player %>

    <div class="flex flex-col justify-center space-y-3">
      <% Player::SKILLS.each do |key, label| %>
        <% value = @player.public_send(key) %>
        <div>
          <div class="mb-1 flex items-center justify-between text-xs">
            <span class="font-medium text-gray-600 dark:text-gray-300"><%= label %></span>
            <span class="font-semibold text-gray-700 dark:text-gray-200"><%= value %>/10</span>
          </div>
          <div class="h-2.5 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
            <div class="h-full rounded-full bg-gradient-to-r from-emerald-600 to-emerald-700 dark:from-emerald-500 dark:to-emerald-600" style="width: <%= value * 10 %>%"></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <% if @player.appearances.any? %>
    <h2 class="mt-8 mb-2 font-semibold text-gray-700 dark:text-gray-200">Game history</h2>
    <ul class="divide-y divide-gray-100 rounded-md border border-gray-100 dark:divide-gray-800 dark:border-gray-800">
      <% @player.appearances.sort_by { |a| a.game.played_on }.reverse.each do |appearance| %>
        <li class="flex items-center justify-between px-3 py-2 text-sm">
          <%= link_to appearance.game.played_on.strftime("%d %b %Y"), appearance.game, class: "text-emerald-700 hover:underline dark:text-emerald-400" %>
          <span class="text-gray-500 dark:text-gray-400">
            <%= appearance.team_name %> · <%= appearance.result.capitalize %>
            <% if appearance.goals > 0 %> · ⚽ × <%= appearance.goals %><% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
