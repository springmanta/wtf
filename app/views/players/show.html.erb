<% content_for :title, @player.name %>

<div class="mb-6 flex items-center justify-between">
  <%= link_to "← All players", players_path, class: "text-sm text-emerald-700 hover:underline" %>
  <div class="flex gap-3">
    <%= link_to "Edit", edit_player_path(@player), class: "text-sm text-gray-600 hover:underline" %>
    <%= button_to "Delete", @player, method: :delete,
          class: "text-sm text-red-600 hover:underline",
          form: { data: { turbo_confirm: "Delete this player?" } } %>
  </div>
</div>

<div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold"><%= @player.name %></h1>
    <% if @player.active %>
      <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-xs font-medium text-emerald-700">Active</span>
    <% else %>
      <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">Inactive</span>
    <% end %>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-4 text-center">
    <div class="rounded-md bg-gray-50 p-4">
      <div class="text-2xl font-bold"><%= @player.games_played %></div>
      <div class="text-xs text-gray-500">Games played</div>
    </div>
    <div class="rounded-md bg-gray-50 p-4">
      <div class="text-2xl font-bold"><%= @player.goals_scored %></div>
      <div class="text-xs text-gray-500">Goals scored</div>
    </div>
  </div>

  <% if @player.appearances.any? %>
    <h2 class="mt-8 mb-2 font-semibold text-gray-700">Game history</h2>
    <ul class="divide-y divide-gray-100 rounded-md border border-gray-100">
      <% @player.appearances.includes(:game).sort_by { |a| a.game.played_on }.reverse.each do |appearance| %>
        <li class="flex items-center justify-between px-3 py-2 text-sm">
          <%= link_to appearance.game.played_on.strftime("%d %b %Y"), appearance.game, class: "text-emerald-700 hover:underline" %>
          <span class="text-gray-500">
            <%= appearance.team_name %> · <%= appearance.result.capitalize %>
            <% if appearance.goals > 0 %> · ⚽ × <%= appearance.goals %><% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
